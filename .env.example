# ============================================================
# .env.example —— 配置模板（可以安全提交到 Git）
# ============================================================
# 用法：
#   1. 复制本文件为 .env      ->  copy .env.example .env
#   2. 填入你自己的邮箱和授权码
#   3. .env 已被 .gitignore 忽略，不会进入版本库
#
# 注意：本文件只放占位符，永远不要在这里填写真实凭据！
# ============================================================
#
# ⚠️⚠️ 授权码不要贴给任何人、任何工具 ⚠️⚠️
#
# 一旦把授权码贴进对话窗口（聊天软件、AI 助手、工单、截图…），
# 它就等同于**已泄露**：对方凭它就能以你的名义收发邮件。
# 「贴出来再删掉」没有用——消息记录里已经有了。
#
# 真泄露了怎么办（只需一分钟，且**不需要**改 QQ 密码）：
#   登录 QQ 邮箱网页版 -> 设置 -> 账户 -> 「IMAP/SMTP服务」
#   -> 删除/停用当前授权码 -> 重新生成一个
#   -> 把新码填进本机的 .env
# 旧码随即失效。
# ============================================================

# ---------- QQ 邮箱 SMTP 认证（必填）----------
# 你的完整 QQ 邮箱地址
SMTP_EMAIL=

# QQ 邮箱「授权码」，不是 QQ 登录密码！
# 获取方式：登录 QQ 邮箱网页版 -> 设置 -> 账户
#          -> 开启「IMAP/SMTP服务」-> 生成 16 位授权码
# 授权码只在生成时显示一次，请立即保存到 .env 中
SMTP_PASSWORD=

# ---------- 可选：日志格式 ----------
# 设为 1/true/yes 时，日志以单行 JSON 输出（便于日志系统采集）
# JSON_LOGS=1

# ---------- 可选但强烈建议：MCP 端点访问令牌 ----------
# 设置后，所有对 /mcp 的请求都必须携带 Authorization: Bearer <token>。
# 留空则不启用鉴权——此时请务必把 MCP_HOST 保持为 127.0.0.1，不要对外监听。
# 生成一个随机令牌：python -c "import secrets; print(secrets.token_urlsafe(32))"
# MCP_AUTH_TOKEN=

# ---------- 可选：发送确认（IMAP 回读）----------
# 开启后，每次发送会用 IMAP 查询 QQ 的「已发送」文件夹，
# 确认这封信确实被 QQ 接收并归档。会增加约 1-3 秒耗时，因此默认关闭。
#
# 注意：这只证明「QQ 已接收并归档」，不证明「收件人已收到」。
# 实测被 550 拒绝的邮件同样会出现在已发送里，因此它不是投递确认。
# EMAIL_CONFIRM_DELIVERY=true
# IMAP_SERVER=imap.qq.com
# IMAP_PORT=993
# IMAP_SENT_FOLDER="Sent Messages"
# CONFIRM_ATTEMPTS=3
# CONFIRM_INTERVAL=2.0

# ---------- 可选：重试与幂等 ----------
# 发送总尝试次数（含首次）。仅对瞬时故障重试（4xx、连接断裂、超时）；
# 550 / 535 等永久错误永不重试。设为 1 表示不重试。
# SEND_MAX_ATTEMPTS=3
# SEND_RETRY_INITIAL_DELAY=1.0
# SEND_RETRY_BACKOFF=2.0

# 连接在发送中断裂时是否换新连接重试一次。
# SMTP 是 at-least-once 语义，若断开发生在服务器已接收之后，重连会造成重复邮件。
# 默认开启（更常见的故障是空闲连接在传正文前被回收）。更不能容忍重复时请置 false，
# 并改用发送工具的 idempotency_key 参数。
# SEND_RETRY_ON_RECONNECT=true

# 幂等键的保留时长（秒），以及「处理中」被视为卡死的时长。
# IDEMPOTENCY_TTL=3600
# IDEMPOTENCY_INFLIGHT_TIMEOUT=300

# ---------- 可选：Ollama（仅对话管家 email_butler.py 需要）----------
# 管家在启动时读取这两项。地址一般不用改；
# 换更大的模型前记得先拉取：ollama pull qwen2.5:7b
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:3b

# ---------- 可选：监听地址 ----------
# 默认 0.0.0.0（对外监听）。若只在本机使用，建议改为 127.0.0.1。
# MCP_HOST=127.0.0.1
