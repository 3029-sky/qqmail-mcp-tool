# CI 专用的占位配置。
#
# 测试套件通过替换 smtplib.SMTP_SSL 与注入替身对象，完全不发起真实网络请求，
# 因此这里只需要让 Settings 校验通过，值可以是任意假数据。
#
# 用法：cp .env.test .env && pytest

SMTP_SERVER=smtp.qq.com
SMTP_PORT=465
SMTP_EMAIL=ci-test@example.com
SMTP_PASSWORD=ci-dummy-authorization-code

MCP_HOST=127.0.0.1
MCP_PORT=8000
DEBUG=false

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
