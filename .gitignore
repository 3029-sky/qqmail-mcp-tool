# ============================================================
# 敏感信息 —— 绝对不要提交
# ============================================================
# 真实配置：包含 QQ 邮箱授权码，只存在于本机
.env
.env.*
!.env.example
# 保险：任何目录下的 .env 变体
**/.env
**/.env.local
**/.env.production

# 运行时可能生成的环境配置备份（含邮箱等个人信息）
attachments/*.json
attachments/环境备份_*.json
attachments/我的环境备份.json
attachments/老师环境配置详细版.json

# ============================================================
# 虚拟环境 —— 不要提交，用 requirements.txt 重建
# ============================================================
venv/
.venv/
env/
ENV/
**/venv/
**/.venv/
# 项目根目录下误建的空文件（Windows 重定向误操作产物）
python

# ============================================================
# Python 运行时产物
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/

# ============================================================
# 测试与覆盖率
# ============================================================
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/

# CI 会把 .env.test 复制成 .env 来跑测试，复制产物不入库
.env.test

# ============================================================
# IDE / 编辑器
# ============================================================
.idea/
.vscode/
*.swp
*.swo
*~

# ============================================================
# 操作系统
# ============================================================
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
